{
    "name": "eril/crud",
    "description": "Advanced CRUD operations and Query Builder with subquery support",
    "keywords": [
        "crud",
        "query-builder",
        "database",
        "pdo",
        "orm",
        "model"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Eril TS Carvalho",
            "email": "erilandocarvalho@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Eril\\CRUD\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Eril\\CRUD\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "./vendor/bin/phpunit",
        "test-unit": "./vendor/bin/phpunit tests/CRUDTest.php",
        "test-integration": "./vendor/bin/phpunit tests/CRUDIntegrationTest.php"
    }
}
